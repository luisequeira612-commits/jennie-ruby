<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ruby_shortcuts_widget"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center"
    android:padding="10dp"
    android:background="@drawable/ruby_widget_background">

    <TextView
        android:id="@+id/ruby_shortcut_app"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:background="#28111B"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/ruby_shortcut_open_app"
        android:text="✦\nJENNIE RUBY\nOPEN APP"
        android:textColor="#F6DCE5"
        android:textStyle="bold"
        android:textSize="12sp"
        android:lineSpacingExtra="4dp" />

    <View
        android:layout_width="8dp"
        android:layout_height="1dp" />

    <TextView
        android:id="@+id/ruby_shortcut_wallpapers"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:background="#28111B"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/ruby_shortcut_open_wallpapers"
        android:text="◈\nRUBY WALLS\nWALLPAPERS"
        android:textColor="#E8A0B5"
        android:textStyle="bold"
        android:textSize="12sp"
        android:lineSpacingExtra="4dp" />
</LinearLayout>
