<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ruby_clock_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="start|center_vertical"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingTop="2dp"
    android:paddingBottom="2dp"
    android:background="@android:color/transparent"
    android:contentDescription="@string/ruby_clock_widget_accessibility">

    <TextClock
        android:id="@+id/ruby_clock_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="start"
        android:format12Hour="h:mm"
        android:format24Hour="h:mm"
        android:fontFamily="@font/playfair_display"
        android:textColor="#E8A0A8"
        android:textSize="38sp"
        android:includeFontPadding="false"
        android:drawableTop="@drawable/ruby_crown"
        android:drawablePadding="2dp"
        android:shadowColor="#7A1624"
        android:shadowDx="0"
        android:shadowDy="2"
        android:shadowRadius="4"
        android:importantForAccessibility="yes" />

    <TextView
        android:id="@+id/ruby_clock_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:fontFamily="@font/cormorant_garamond"
        android:text="Sáb, 1 de Noviembre"
        android:textColor="#E8A0A8"
        android:textSize="13sp"
        android:includeFontPadding="false"
        android:singleLine="true" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="49dp"
            android:layout_height="1dp"
            android:background="#E8A0A8" />

        <ImageView
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:src="@drawable/ruby_four_point_star"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="49dp"
            android:layout_height="1dp"
            android:background="#E8A0A8" />
    </LinearLayout>
</LinearLayout>
