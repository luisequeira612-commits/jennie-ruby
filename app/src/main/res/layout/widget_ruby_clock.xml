<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ruby_clock_widget"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="14dp"
    android:paddingBottom="14dp"
    android:background="@drawable/ruby_widget_background"
    android:contentDescription="@string/ruby_clock_widget_accessibility">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="J E N N I E   •   R U B Y"
        android:textColor="#E8A0B5"
        android:textSize="10sp"
        android:letterSpacing="0.12"
        android:fontFamily="sans-serif-medium" />

    <TextClock
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:format12Hour="h:mm"
        android:format24Hour="HH:mm"
        android:textColor="#F6DCE5"
        android:textSize="38sp"
        android:fontFamily="sans-serif-light"
        android:includeFontPadding="false"
        android:importantForAccessibility="yes" />

    <TextClock
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:format12Hour="EEEE, d MMM"
        android:format24Hour="EEEE, d MMM"
        android:textColor="#C89AA8"
        android:textSize="11sp"
        android:fontFamily="sans-serif" />
</LinearLayout>
