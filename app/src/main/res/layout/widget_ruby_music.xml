<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:padding="7dp" android:background="@drawable/ruby_music_card">
 <ImageView android:id="@+id/music_art" android:layout_width="52dp" android:layout_height="52dp" android:scaleType="centerCrop" android:background="@drawable/ruby_music_art_round" android:clipToOutline="true" android:src="@drawable/ruby_music_placeholder"/>
 <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="9dp">
  <TextView android:id="@+id/music_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/cormorant_garamond" android:textColor="#F3E6E6" android:textSize="18sp" android:maxLines="1" android:ellipsize="end" android:text="Sin reproducción"/>
  <TextView android:id="@+id/music_artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/cormorant_garamond" android:textColor="#D7A0AA" android:textSize="14sp" android:maxLines="1" android:ellipsize="end"/>
 </LinearLayout>
 <ImageButton android:id="@+id/music_previous" android:layout_width="30dp" android:layout_height="42dp" android:background="@android:color/transparent" android:src="@drawable/ruby_music_previous" android:contentDescription="Anterior"/>
 <ImageButton android:id="@+id/music_play" android:layout_width="34dp" android:layout_height="42dp" android:background="@android:color/transparent" android:src="@drawable/ruby_music_play" android:contentDescription="Reproducir o pausar"/>
 <ImageButton android:id="@+id/music_next" android:layout_width="30dp" android:layout_height="42dp" android:background="@android:color/transparent" android:src="@drawable/ruby_music_next" android:contentDescription="Siguiente"/>
 <ImageButton android:id="@+id/music_spotify" android:layout_width="34dp" android:layout_height="42dp" android:background="@android:color/transparent" android:src="@drawable/ruby_spotify_round" android:contentDescription="Abrir Spotify"/>
</LinearLayout>
