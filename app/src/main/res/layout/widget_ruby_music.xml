<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:padding="5dp" android:background="@drawable/ruby_music_card">
 <ImageView android:id="@+id/music_art" android:layout_width="42dp" android:layout_height="42dp" android:scaleType="centerCrop" android:background="@drawable/ruby_music_art_round" android:clipToOutline="true" android:src="@drawable/ruby_music_placeholder"/>
 <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="5dp">
  <TextView android:id="@+id/music_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/cormorant_garamond" android:textColor="#F3E6E6" android:textSize="16sp" android:maxLines="1" android:ellipsize="end" android:text="Sin reproducción"/>
  <TextView android:id="@+id/music_artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/cormorant_garamond" android:textColor="#D7A0AA" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"/>
 </LinearLayout>
 <ImageButton android:id="@+id/music_previous" android:layout_width="20dp" android:layout_height="36dp" android:background="@android:color/transparent" android:src="@drawable/ruby_music_previous" android:contentDescription="Anterior" android:scaleType="fitCenter" android:padding="2dp"/>
 <ImageButton android:id="@+id/music_play" android:layout_width="24dp" android:layout_height="36dp" android:background="@android:color/transparent" android:src="@drawable/ruby_music_play" android:contentDescription="Reproducir o pausar" android:scaleType="fitCenter" android:padding="2dp"/>
 <ImageButton android:id="@+id/music_next" android:layout_width="20dp" android:layout_height="36dp" android:background="@android:color/transparent" android:src="@drawable/ruby_music_next" android:contentDescription="Siguiente" android:scaleType="fitCenter" android:padding="2dp"/>
</LinearLayout>