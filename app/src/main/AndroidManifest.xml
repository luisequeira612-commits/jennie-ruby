<manifest xmlns:android="http://schemas.android.com/apk/res/android">
<queries>\n    <package android:name="com.spotify.music" />
    <package android:name="org.videolan.vlc" />\n    <package android:name="com.google.android.apps.youtube.music" />\n    <package android:name="com.google.android.apps.maps" />\n    <package android:name="com.google.android.gm" />\n    <package android:name="com.google.android.apps.docs" />\n    <package android:name="com.google.android.apps.photos" />\n    <package android:name="com.google.android.calendar" />\n    <package android:name="com.facebook.katana" />\n    <package android:name="com.facebook.orca" />\n    <package android:name="org.telegram.messenger" />\n    <package android:name="com.snapchat.android" />\n    <package android:name="com.twitter.android" />\n    <package android:name="com.pinterest" />\n    <package android:name="com.reddit.frontpage" />\n    <package android:name="com.netflix.mediaclient" />\n    <package android:name="com.disney.disneyplus" />\n    <package android:name="com.wbd.stream" />\n    <package android:name="com.crunchyroll.crunchyroid" />\n    <package android:name="tv.twitch.android.app" />\n    <package android:name="com.openai.chatgpt" />\n    <package android:name="com.anthropic.claude" />\n</queries>\n    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <application
        android:allowBackup="false"
        android:icon="@drawable/jennie_ruby_launcher"
        android:label="JENNIE RUBY"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".WallpaperActivity" android:exported="false" />
        <receiver android:name=".RubyClockWidgetProvider" android:exported="true" android:label="@string/ruby_clock_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
                <action android:name="android.intent.action.DATE_CHANGED"/>
                <action android:name="android.intent.action.TIME_SET"/>
                <action android:name="android.intent.action.TIMEZONE_CHANGED"/>
                <action android:name="android.intent.action.LOCALE_CHANGED"/>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.USER_PRESENT"/>
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/ruby_clock_widget_info"/>
        </receiver>
        <receiver android:name=".RubySignatureWidgetProvider" android:exported="true" android:label="@string/ruby_signature_widget_label">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/ruby_signature_widget_info"/>
        </receiver>
        <receiver android:name=".RubyNameWidgetProvider" android:exported="true" android:label="@string/jennie_ruby_widget_label">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/jennie_ruby_widget_info"/>
        </receiver>
        <receiver android:name=".RubyMusicWidgetProvider" android:exported="true" android:label="@string/ruby_music_widget_label">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/><action android:name="com.luisequeira612.jennieruby.MUSIC_REFRESH"/></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/ruby_music_widget_info"/>
        </receiver>
        <receiver android:name=".RubyMediaControlReceiver" android:exported="false"/>
        <service android:name=".RubyMediaSessionService" android:label="@string/ruby_music_widget_label" android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE" android:exported="true">
            <intent-filter><action android:name="android.service.notification.NotificationListenerService"/></intent-filter>
        </service>
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
            <intent-filter><action android:name="com.novalauncher.THEME"/></intent-filter>
        </activity>
    </application>
</manifest>